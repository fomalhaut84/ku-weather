# 한국 기상청 API 인증키
# https://apihub.kma.go.kr에서 발급
WEATHER_API_KEY=your_weather_api_key_here

# Slack 웹훅 URL
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# 모니터링할 지역 코드 (쉼표로 구분, 빈 값이면 전국)
# 예: 서울, 부산, 제주도 등
TARGET_REGION_IDS=

# 모니터링할 특보 종류 (쉼표로 구분, 빈 값이면 전체)
# W:강풍, R:호우, C:한파, D:건조, O:해일, N:지진해일, V:풍랑, T:태풍, S:대설, Y:황사, H:폭염, F:안개
WARNING_TYPES=

# 날씨해설 부제목코드 (선택사항, 빈 값이면 전체)
# 11:초단기, 12:단기, 13:중기, 99:직접입력
SUBCD=

# 체크 간격 (분 단위)
CHECK_INTERVAL_MINUTES=30

# 개발 모드 (true/false)
NODE_ENV=development

# 디버그 로그 출력 (true/false)
DEBUG=false