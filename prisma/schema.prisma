// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 기상특보 데이터
model WeatherAlert {
  id           String   @id @default(uuid())
  regionId     String   // 지역코드 (REG_ID)
  regionName   String   // 지역명 (REG_NAME)
  upperRegion  String?  // 상위지역 (서울, 경기 등)
  warningType  String   // 특보종류 (WRN: W, R, C 등)
  warningLevel String   // 특보수준 (LVL: 1,2,3)
  command      String   // 특보명령 (CMD)
  announcedAt  DateTime // 발표시각 (TM_FC)
  effectiveAt  DateTime // 발효시각 (TM_EF)
  endTime      DateTime? // 종료시각 (TM_ED)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 복합 유니크 제약조건 (같은 지역의 같은 특보는 하나만 존재)
  @@unique([regionId, warningType])
  // 인덱스
  @@index([regionId, createdAt])
  @@index([warningType, warningLevel])
  @@index([announcedAt])
  @@index([upperRegion])
  // Phase 5 최적화: 추가 인덱스
  @@index([command]) // command != '6' 필터링에 유용
  @@index([upperRegion, warningType]) // 복합 필터링 최적화
  @@index([upperRegion, warningLevel]) // 지역별 수준 조회 최적화
  @@map("weather_alerts")
}

// 특보 변동 이력
model AlertHistory {
  id           String   @id @default(uuid())
  alertId      String?  // WeatherAlert ID (nullable)
  regionId     String   // 지역코드
  regionName   String   // 지역명
  upperRegion  String?  // 상위지역
  warningType  String   // 특보종류
  warningLevel String   // 특보수준
  changeType   String   // 변동 유형: NEW, RESOLVED, LEVEL_UP, LEVEL_DOWN, TIME_EXTENDED, MODIFIED
  previousData Json?    // 이전 상태 (JSON)
  currentData  Json?    // 현재 상태 (JSON)
  timestamp    DateTime @default(now())

  @@index([regionId, timestamp])
  @@index([changeType])
  @@index([timestamp])
  @@index([warningType])
  // Phase 5 최적화: 추가 복합 인덱스
  @@index([timestamp, warningType]) // 기간별 특보 종류 필터링
  @@index([timestamp, changeType]) // 기간별 변동 유형 필터링
  @@index([timestamp, upperRegion]) // 기간별 지역 통계에 유용
  @@index([upperRegion, timestamp]) // 지역별 시계열 조회
  @@map("alert_histories")
}

// 지역 매핑 (캐싱용)
model RegionMapping {
  id          String   @id @default(uuid())
  regionId    String   @unique
  regionName  String
  upperRegion String
  createdAt   DateTime @default(now())

  @@index([regionId])
  @@index([upperRegion])
  @@map("region_mappings")
}

// 웹 대시보드 접근 토큰
model WebAccessToken {
  id          String    @id @default(uuid())
  token       String    @unique // 고유 토큰 문자열
  platform    String    // 플랫폼: slack, telegram, discord, email
  userId      String    // 플랫폼별 사용자 ID
  displayName String?   // 사용자 표시 이름
  expiresAt   DateTime  // 토큰 만료 시각
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime? // 마지막 사용 시각 (선택적)

  // 복합 유니크 제약조건 (같은 플랫폼의 같은 사용자는 하나의 활성 토큰만 보유)
  @@unique([platform, userId])
  // 인덱스
  @@index([token, expiresAt]) // 토큰 검증 최적화
  @@index([platform, userId]) // 사용자별 토큰 조회
  @@index([expiresAt]) // 만료된 토큰 정리
  @@map("web_access_tokens")
}
